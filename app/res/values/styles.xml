<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FBFBFB</item>
        <item name="android:statusBarColor">#FBFBFB</item>
        <item name="android:navigationBarColor">#FBFBFB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#2F6FED</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0D0E</item>
        <item name="android:statusBarColor">#0D0D0E</item>
        <item name="android:navigationBarColor">#0D0D0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">#2F6FED</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
